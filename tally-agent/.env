# Tally Push Agent Configuration (Ready-to-Run)

# Local Tally Prime XML HTTP Gateway (Running on port 9000)
TALLY_HOST=http://127.0.0.1
TALLY_PORT=9000

# Live Cloudflare Tunnel URL pointing to your Dokploy Dashboard
REMOTE_DOKPLOY_API=https://tally.plystory.si/api/v1/sync-push

# Interval between sync cycles (in seconds)
# 300 = every 5 minutes | 60 = every 1 minute
SYNC_INTERVAL_SECS=300

# Tally Sync Agent Configuration

# Tally Server Settings (where Tally Prime / ERP 9 is running)
TALLY_HOST=http://127.0.0.1
TALLY_PORT=9000

# Backend API endpoint to push or update synced data
# If backend is on the same machine, leave 127.0.0.1
# If backend is on another server, set: http://<STATIC_IP_OR_DOMAIN>:8000/api/v1/sync
BACKEND_API_URL=http://127.0.0.1:8000/api/v1/sync

# Interval between sync cycles (in seconds)
# 300 = every 5 minutes | 600 = every 10 minutes | 60 = every 1 minute
SYNC_INTERVAL_SECS=300
